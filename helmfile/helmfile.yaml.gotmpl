{{- $oidcIssuerMode := requiredEnv "OIDC_ISSUER_MODE" -}}
{{- $oidcIssuerUrl := env "OIDC_ISSUER_URL" | default "" -}}
{{- $extAuthzEnabled := eq (env "EXT_AUTHZ_ENABLED" | default "false") "true" -}}
{{- if eq $oidcIssuerMode "mock" -}}
{{- if not (or (eq .Environment.Name "kind") (eq .Environment.Name "e2e-kind") (eq .Environment.Name "e2e-gcp")) -}}
{{- fail "OIDC_ISSUER_MODE=mock is test-only and is allowed only with kind, e2e-kind, or e2e-gcp" -}}
{{- end }}
{{- if and $extAuthzEnabled (ne $oidcIssuerUrl "") -}}
{{- fail "OIDC_ISSUER_URL must be empty when OIDC_ISSUER_MODE=mock; remove the external issuer or select external mode" -}}
{{- end }}
{{- if and $extAuthzEnabled (eq (env "JWT_AUTH_ENABLED" | default "false") "true") -}}
{{- fail "JWT_AUTH_ENABLED=true is incompatible with EXT_AUTHZ_ENABLED=true and OIDC_ISSUER_MODE=mock; the API must not validate the HTTP mock issuer" -}}
{{- end }}
{{- $oidcIssuerUrl = printf "http://hyperfleet-mock-oidc.%s.svc.cluster.local:8080/default" (requiredEnv "NAMESPACE") -}}
{{- else if eq $oidcIssuerMode "external" -}}
{{- if and $extAuthzEnabled (not (regexMatch "^https://[a-zA-Z0-9]" $oidcIssuerUrl)) -}}
{{- fail (printf "OIDC_ISSUER_URL must be a valid https:// URL when EXT_AUTHZ_ENABLED=true and OIDC_ISSUER_MODE=external (got: %q)" $oidcIssuerUrl) -}}
{{- end }}
{{- else -}}
{{- fail (printf "OIDC_ISSUER_MODE=%q must be mock or external" $oidcIssuerMode) -}}
{{- end }}
{{- /*
  Desire delivery (opt-in): Redis desire store + hyperfleet-applier, and the
  single cl-desire adapter in place of the e2e adapter set. Only the e2e
  environments define the desire adapter set; elsewhere the toggle would drop
  Maestro from local-up-kind while the regular adapters still need it.

  TODO(HYPERFLEET-1503): the toggle swaps which adapter set is in the Helmfile
  state, so a destroy or apply with the other value leaves the previous set's
  adapter releases installed. This lasts only while both sets exist; once the
  Maestro-based e2e adapter sets are removed, drop the toggle and load the
  desire adapter set unconditionally.
*/ -}}
{{- $desire := eq (env "DESIRE_DELIVERY_ENABLED" | default "false") "true" -}}
{{- if and $desire (not (or (eq .Environment.Name "e2e-kind") (eq .Environment.Name "e2e-gcp"))) -}}
{{- fail "DESIRE_DELIVERY_ENABLED=true is supported only with e2e-kind or e2e-gcp" -}}
{{- end }}
# Helmfile configuration
# Documentation: https://helmfile.readthedocs.io/

# Common Helm defaults applied to all releases
helmDefaults:
  createNamespace: true
  wait: true
  timeout: 300
  cleanupOnFail: true

# Base values for all environments
values:
  - namespace: {{ requiredEnv "NAMESPACE" }}
  - oidcIssuerMode: {{ $oidcIssuerMode | quote }}
  - oidcIssuerUrl: {{ $oidcIssuerUrl | quote }}
  - chartOrg: {{ env "CHART_ORG" | default "openshift-hyperfleet" }}
  # API audience shared by human JWTs and adapter/sentinel ServiceAccount tokens.
  - apiAudience: hyperfleet-api
  - desireDeliveryEnabled: {{ $desire }}
  - charts:
      api:
        chartRef: {{ env "API_CHART_REF" | default "main" }}
      sentinel:
        chartRef: {{ env "SENTINEL_CHART_REF" | default "main" }}
      adapter:
        chartRef: {{ env "ADAPTER_CHART_REF" | default "main" }}
      applier:
        chartRef: {{ env "APPLIER_CHART_REF" | default "main" }}

# Environment configurations - e2e, e2e-kind, kind, gcp
environments:
  e2e-gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
        runId: {{ env "RUN_ID" | quote }}
      - {{ if $desire }}environments/adapter-configs-desire.yaml.gotmpl{{ else }}environments/e2e-gcp/adapter-configs.yaml.gotmpl{{ end }}
      - environments/e2e-gcp/sentinel-configs.yaml
  e2e-kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
        runId: {{ env "RUN_ID" | quote }}
      - {{ if $desire }}environments/adapter-configs-desire.yaml.gotmpl{{ else }}environments/e2e-kind/adapter-configs.yaml.gotmpl{{ end }}
      - environments/e2e-kind/sentinel-configs.yaml
  kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
      - environments/kind/adapter-configs.yaml.gotmpl
      - environments/kind/sentinel-configs.yaml.gotmpl
  gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
      - environments/gcp/adapter-configs.yaml.gotmpl
      - environments/gcp/sentinel-configs.yaml.gotmpl

commonLabels:
  group: hyperfleet

---

repositories:
  - name: hyperfleet-api
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-api@charts?ref={{ .Values.charts.api.chartRef }}&sparse=0
  - name: hyperfleet-sentinel
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-sentinel@charts?ref={{ .Values.charts.sentinel.chartRef }}&sparse=0
  - name: hyperfleet-adapter
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-adapter@charts?ref={{ .Values.charts.adapter.chartRef }}&sparse=0
{{ if .Values.desireDeliveryEnabled }}
  # Declared only for desire delivery, so other runs never fetch it. Helmfile
  # prepares charts only for installed releases and removes a disabled release
  # by name, so the hyperfleet-applier release below needs no repository then.
  - name: hyperfleet-applier
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-applier@charts?ref={{ .Values.charts.applier.chartRef }}&sparse=0
{{ end }}

releases:
  - name: external-dns
    namespace: {{ .Values.namespace }}
    chart: ../helm/external-dns
    installed: {{ eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    labels:
      component: external-dns
{{ if eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    values:
      - values/external-dns.yaml.gotmpl
{{ end }}
{{ if eq .Values.brokerType "rabbitmq" }}
  - name: rabbitmq
    namespace: {{ .Values.namespace }}
    chart: ../helm/rabbitmq
    labels:
      component: rabbitmq
{{ end }}

  # Test-only human OIDC issuer. It must be ready before Authorino starts
  # discovery and before Envoy can send authenticated traffic.
  - name: hyperfleet-mock-oidc
    namespace: {{ .Values.namespace }}
    chart: ../helm/mock-oidc
    # Keep this release in state when disabled so Helmfile removes a previously
    # installed mock issuer during an auth-mode change or teardown.
    installed: {{ and (eq (env "EXT_AUTHZ_ENABLED" | default "false") "true") (eq .Values.oidcIssuerMode "mock") }}
    labels:
      component: mock-oidc
    values:
      - fullnameOverride: hyperfleet-mock-oidc

  # Desire delivery (DESIRE_DELIVERY_ENABLED=true): the Redis desire store and
  # the applier that serves this namespace's store partition. Both stay in state
  # when disabled so Helmfile removes them on a toggle change or teardown.
  - name: redis
    namespace: {{ .Values.namespace }}
    chart: ../helm/redis
    installed: {{ .Values.desireDeliveryEnabled }}
    labels:
      component: redis
    values:
      # Only the store's clients: the cl-desire adapter and the applier
      - networkPolicy:
          allowedClients:
            - app.kubernetes.io/name: hyperfleet-adapter
              app.kubernetes.io/instance: cl-desire
            - app.kubernetes.io/name: hyperfleet-applier
              app.kubernetes.io/instance: hyperfleet-applier

  - name: hyperfleet-applier
    namespace: {{ .Values.namespace }}
    chart: hyperfleet-applier/hyperfleet-applier
    installed: {{ .Values.desireDeliveryEnabled }}
    needs:
      - redis
    labels:
      component: applier
    values:
      - values/base-applier.yaml.gotmpl

  # HyperFleet API
  - name: hyperfleet-api
    namespace: {{ .Values.namespace }}
    chart: hyperfleet-api/hyperfleet-api
    needs:
      - hyperfleet-gateway
    labels:
      component: api
    values:
      - values/base-api.yaml.gotmpl

  - name: hyperfleet-gateway
    namespace: {{ .Values.namespace }}
    chart: ../helm/hyperfleet-gateway
{{ if and (eq (env "EXT_AUTHZ_ENABLED" | default "false") "true") (eq .Values.oidcIssuerMode "mock") }}
      - hyperfleet-mock-oidc
{{ end }}
    labels:
      component: gateway
    values:
      - values/base-gateway.yaml.gotmpl

  - name: network-policies
    namespace: {{ .Values.namespace }}
    chart: ../helm/network-policies
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: network-policies
    values:
      - values/base-network-policies.yaml.gotmpl

{{ range .Values.sentinels }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-sentinel/hyperfleet-sentinel
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: sentinel
    values:
      - ./values/base-sentinel.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}

{{ range .Values.adapters }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-adapter/hyperfleet-adapter
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: adapter
    values:
      - ./values/base-adapter.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}
