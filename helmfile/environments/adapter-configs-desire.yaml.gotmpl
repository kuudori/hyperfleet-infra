{{ $namespace := requiredEnv "NAMESPACE" }}
{{- /*
  The desire store: the redis release's Service and port in this namespace.
  cl-desire writes to it below; the applier reads it through desireStoreUrl
  (values/base-applier.yaml.gotmpl), so both always use the same store.
*/}}
{{- $desireStoreUrl := "redis://redis:6379/0" }}
desireStoreUrl: {{ $desireStoreUrl }}
{{- /*
  Desire delivery adapter set, loaded for both e2e environments instead of
  their adapter-configs.yaml.gotmpl when DESIRE_DELIVERY_ENABLED=true; only the
  broker block differs by environment. The API requires only cl-desire.

  cl-desire runs the adapter chart's shipped remote-two-resources example: its
  task config and manifests come from the chart (adapterTaskConfig.files). The
  deployment config is inline rather than a setFiles file so target_cluster
  renders as this namespace. The applier serves the same partition
  (config.managementCluster in values/base-applier.yaml.gotmpl).
*/}}
adapters:
  - name: cl-desire
    resourceType: clusters
    values:
      - adapterTaskConfig:
          create: true
          files:
            task-config.yaml: examples/remote-two-resources/adapter-task-config.yaml
            namespace.yaml: examples/remote-two-resources/namespace.yaml
            configmap.yaml: examples/remote-two-resources/configmap.yaml
        adapterConfig:
          create: true
          log:
            level: debug
          yaml: |
            adapter:
              name: cl-desire

            # Log the full merged configuration after load (default: false)
            debug_config: false
            log:
              level: debug

            clients:
              hyperfleet_api:
                base_url: CHANGE_ME
                version: v1
                timeout: 2s
                retry_attempts: 3
                retry_backoff: exponential

              broker:
                subscription_id: CHANGE_ME
                topic: CHANGE_ME

              kubernetes:
                api_version: "v1"

            # Names referenced by the example task config. Redis runs in this
            # namespace without authentication.
            stores:
              remote-store:
                type: redis
                url: {{ $desireStoreUrl }}

            transports:
              remote-primary:
                type: remote
                store: remote-store
                target_cluster: "{{ $namespace }}"
                resource_plurals:
                  "v1/Namespace": namespaces
                  "v1/ConfigMap": configmaps
        broker:
          create: true
{{- if eq .Environment.Name "e2e-gcp" }}
          googlepubsub:
            subscriptionId: {{ $namespace }}-clusters-cl-desire
            topic: {{ $namespace }}-clusters
            deadLetterTopic: {{ $namespace }}-clusters-dlq
{{- else }}
          rabbitmq:
            url: "amqp://guest:guest@rabbitmq:5672"
            queue: {{ $namespace }}-clusters-cl-desire
            exchange: {{ $namespace }}-clusters
            routingKey: "#"
{{- end }}
